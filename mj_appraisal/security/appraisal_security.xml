<odoo>
    <!-- Odoo 19+: groups are attached to a privilege, which belongs to a category -->
    <record id="privilege_emp_performance_appraisal" model="res.groups.privilege">
        <field name="name">Employee Performance Appraisal</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- ============================================================
         GROUPS
         ============================================================ -->
    <record id="group_performance_appraisal_appraiser" model="res.groups">
        <field name="name">Appraiser (score only)</field>
        <field name="privilege_id" ref="privilege_emp_performance_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can only fill in the Obtained Score of the evaluation
            lines of appraisals where they are set as the appraiser, and only while
            the appraisal is still in Draft. Combining this group with Viewer widens
            what they can *see*, never what they can *change*; only the Performance
            Appraisal Manager group lifts the restriction.</field>
    </record>

    <record id="group_performance_appraisal_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_emp_performance_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_performance_appraisal_manager" model="res.groups">
        <field name="name">Performance Appraisal Manager</field>
        <field name="privilege_id" ref="privilege_emp_performance_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('mj_appraisal.group_performance_appraisal_viewer'))]"/>
    </record>

    <!-- ============================================================
         ACCESS

         Odoo 20 replaced ir.model.access + ir.rule with a single model,
         ir.access (see security/ir.access.csv). Each row grants a group a set
         of operations (c/r/u/d), optionally limited to a domain. Rows are
         OR-ed over all the groups a user belongs to, so:

           * Viewer / Manager read everything.
           * Appraiser alone reads and updates only what they must score.
           * "Appraiser + Viewer" reads everything but still updates only
             their own rows, because Viewer grants no update at all.
           * Managers create / update everything (no delete on appraisals).

         Which *fields* an appraiser may write is not expressible here; that
         is enforced in models/appraisal_access_mixin.py.
         ============================================================ -->
</odoo>
